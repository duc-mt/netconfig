# Copy to .env and chmod 600 .env  (netops warns if it is group/world readable)

# Default login for every device
# Either NETOPS_PASSWORD or NETOPS_KEY_FILE (or both) can be used.
NETOPS_USERNAME=netops
NETOPS_PASSWORD=change-me
# NETOPS_KEY_FILE=/home/netops/.ssh/id_ed25519

# Per-site override: devices whose credential_group is "dc2"
# NETOPS_DC2_USERNAME=dc2-admin
# NETOPS_DC2_PASSWORD='p@ss word #1'
# NETOPS_DC2_KEY_FILE=/home/netops/.ssh/id_rsa_dc2

# Optional enable secret (Cisco/Arista user EXEC logins); falls back to the login password
# NETOPS_ENABLE_PASSWORD=

# Jump host / bastion support
# Global default bastion (can also be configured via -jump-host, -jump-user, -jump-key-file)
# NETOPS_JUMP_HOST=mgmt-gw.example.com:22
# NETOPS_JUMP_USERNAME=svc-jump
# NETOPS_JUMP_PASSWORD=jump-change-me
# NETOPS_JUMP_KEY_FILE=/home/netops/.ssh/jump_key

# Per-named-jump credentials (matched against inventory jump_host column)
# NETOPS_JUMP_BASTION_DC_HOST=bastion-dc.example.com:22
# NETOPS_JUMP_BASTION_DC_USERNAME=svc-dc-jump
# NETOPS_JUMP_BASTION_DC_PASSWORD=dc-jump-pass
# NETOPS_JUMP_BASTION_DC_KEY_FILE=/home/netops/.ssh/dc_jump_key

# ------------------------------------------------------------------------------
# Telegram Alert Notifications (Optional)
# ------------------------------------------------------------------------------
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN="000000000:AAFg-XXXXXXXXXXXXXXXXXXXXXXXXXX"
# TELEGRAM_CHAT_ID="-1001234567890"
# TELEGRAM_MESSAGE_THREAD_ID=""
# TELEGRAM_SILENT=false
# TELEGRAM_PROXY_URL=""

# ------------------------------------------------------------------------------
# CVE Check Sources (Optional, "netops cve")
# ------------------------------------------------------------------------------
# NIST NVD needs no key; a key raises its rate limit.
# NVD_API_KEY=""
# Cisco PSIRT openVuln API: OAuth2 client credentials from https://apiconsole.cisco.com
# CISCO_PSIRT_CLIENT_ID=""
# CISCO_PSIRT_CLIENT_SECRET=""
