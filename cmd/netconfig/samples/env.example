# Copy to .env and chmod 600 .env  (netconfig warns if it is group/world readable)

# Default login for every device
NETCONFIG_USERNAME=netops
NETCONFIG_PASSWORD=change-me

# Per-site override: devices whose credential_group is "dc2"
# NETCONFIG_DC2_USERNAME=dc2-admin
# NETCONFIG_DC2_PASSWORD='p@ss word #1'

# Optional enable secret (Cisco/Arista user EXEC logins); falls back to the login password
# NETCONFIG_ENABLE_PASSWORD=

# Jump host / bastion support
# Global default bastion (can also be passed via -jump-host, -jump-user, -jump-password)
# NETCONFIG_JUMP_HOST=mgmt-gw.example.com:22
# NETCONFIG_JUMP_USERNAME=svc-jump
# NETCONFIG_JUMP_PASSWORD=jump-change-me

# Per-named-jump credentials (matched against inventory jump_host column)
# NETCONFIG_JUMP_BASTION_DC_HOST=bastion-dc.example.com:22
# NETCONFIG_JUMP_BASTION_DC_USERNAME=svc-dc-jump
# NETCONFIG_JUMP_BASTION_DC_PASSWORD=dc-jump-pass
