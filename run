#!/bin/sh
# ==============================================================================
# Script Name:   run
# Description:   Universal cross-platform launcher for netconfig.
# Usage:         ./run [options] [arguments]
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s 2>/dev/null)" in
    CYGWIN*|MINGW*|MSYS*)
        # Windows running under Git Bash / MSYS / Cygwin
        if [ -f "$SCRIPT_DIR/scripts/run.bat" ] && ! command -v bash >/dev/null 2>&1; then
            exec cmd.exe /c "$SCRIPT_DIR/scripts/run.bat" "$@"
        else
            exec /bin/sh "$SCRIPT_DIR/scripts/run.sh" "$@"
        fi
        ;;
    *)
        exec /bin/sh "$SCRIPT_DIR/scripts/run.sh" "$@"
        ;;
esac
